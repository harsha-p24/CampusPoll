# ── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-campuspoll-secret-key-abc123xyz-2024
FLASK_ENV=development
FLASK_DEBUG=True
APP_VERSION=7.0.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///campuspoll.db

# ── Redis ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
RATELIMIT_STORAGE_URL=memory://
USE_CELERY=false

# ── Email ─────────────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=CampusPoll <noreply@campuspoll.com>

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@campuspoll.com
ADMIN_PASSWORD=Admin@123456

# ── Security ──────────────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_PASSWORD=admin

# ── Secrets Backend ───────────────────────────────────────────────────────────
SECRETS_BACKEND=env
