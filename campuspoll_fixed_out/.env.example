# ── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=True
APP_VERSION=6.0.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///campuspoll.db
# Production: postgresql://user:password@localhost/campuspoll

# ── Redis ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
USE_CELERY=false

# ── Email ─────────────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=CampusPoll <your-email@gmail.com>

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@campuspoll.com
ADMIN_PASSWORD=YourSecurePassword@123

# ── Security ──────────────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_PASSWORD=admin

# ── Secrets Backend (optional) ────────────────────────────────────────────────
SECRETS_BACKEND=env
# Options: env | aws | vault | gcp
# AWS_SECRET_NAME=campuspoll/secrets
# AWS_REGION=us-east-1
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=your-vault-token
